import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

def analyze_sql_data(db_path='user_data.db'):
    # Connect to the SQLite database
    conn = sqlite3.connect(db_path)
    
    try:
        # Load data into pandas
        # Assuming the table name is 'user_data' based on the file name
        df = pd.read_sql_query("SELECT * FROM user_data", conn)
        
        # Calculate summary statistics
        print("Summary Statistics from SQL:")
        stats = df.describe()
        print(stats)
        
        # Create graphs for distribution
        numerical_cols = df.select_dtypes(include=['number']).columns
        for col in numerical_cols:
            plt.figure(figsize=(8, 4))
            df[col].hist(bins=20, color='skyblue', edgecolor='black')
            plt.title(f'Distribution of {col} (from SQL)')
            plt.xlabel(col)
            plt.ylabel('Frequency')
            plt.tight_layout()
            plt.savefig(f'{col}_sql_distribution.png')
            print(f"Graph saved as {col}_sql_distribution.png")
            plt.close()
            
    except Exception as e:
        print(f"An error occurred: {e}")
    finally:
        conn.close()

analyze_sql_data()
